{
  "name": "homebridge-mercedes-lock",
  "version": "0.1.0",
  "description": "Homebridge plugin exposing your Mercedes-Benz car's door lock status (read-only) in HomeKit. Handles Mercedes Me account login directly, no Home Assistant required.",
  "license": "MIT",
  "main": "dist/index.js",
  "files": [
    "dist",
    "config.schema.json",
    "CHANGELOG.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kurt-guanwen-wang/homebridge-mercedes-lock.git"
  },
  "bugs": {
    "url": "https://github.com/kurt-guanwen-wang/homebridge-mercedes-lock/issues"
  },
  "homepage": "https://github.com/kurt-guanwen-wang/homebridge-mercedes-lock#readme",
  "engines": {
    "node": ">=18.0.0",
    "homebridge": ">=1.6.0"
  },
  "keywords": [
    "homebridge-plugin",
    "mercedes-benz",
    "mercedes-me"
  ],
  "scripts": {
    "build": "rimraf dist && tsc",
    "watch": "tsc --watch",
    "test:login": "ts-node scripts/test-login.ts",
    "test": "npm run build",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "protobufjs": "^7.3.0",
    "undici": "^6.19.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^11.0.1",
    "@types/node": "^20.11.0",
    "homebridge": "^1.8.0",
    "rimraf": "^5.0.5",
    "semantic-release": "^25.0.9",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.0"
  }
}
