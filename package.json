{
  "name": "homebridge-mercedes-lock",
  "version": "1.3.0",
  "description": "Homebridge plugin exposing your Mercedes-Benz car's door lock, doors, windows, and fuel/EV level (read-only) in HomeKit. Handles Mercedes Me account login directly, no Home Assistant required.",
  "license": "MIT",
  "main": "dist/index.js",
  "files": [
    "dist",
    "config.schema.json",
    "CHANGELOG.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kurt-guanwen-wang/homebridge-mercedes-lock.git"
  },
  "bugs": {
    "url": "https://github.com/kurt-guanwen-wang/homebridge-mercedes-lock/issues"
  },
  "homepage": "https://github.com/kurt-guanwen-wang/homebridge-mercedes-lock#readme",
  "engines": {
    "node": ">=22.19.0",
    "homebridge": ">=1.6.0"
  },
  "keywords": [
    "homebridge-plugin",
    "mercedes-benz",
    "mercedes-me"
  ],
  "scripts": {
    "build": "rimraf dist && tsc",
    "watch": "tsc --watch",
    "test:login": "ts-node scripts/test-login.ts",
    "test": "npm run build && jest",
    "test:unit": "jest",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "protobufjs": "^8.8.1",
    "undici": "^8.12.2",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@homebridge/hap-nodejs": "2.2.2",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^11.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.5",
    "@types/ws": "^8.18.2",
    "homebridge": "^2.4.0",
    "jest": "^30.5.2",
    "rimraf": "^6.1.3",
    "semantic-release": "^25.0.9",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  }
}
